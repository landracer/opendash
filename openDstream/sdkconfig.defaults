# ─────────────────────────────────────────────────────────────────────────────
# OpenDash openDstream — SDK Configuration Defaults
#
# Hardware: ESP32-WROOM-32 (ESP32-DevKitC form factor)
# Role: ESP-NOW to USB Bridge Node
# ─────────────────────────────────────────────────────────────────────────────

#
# Target Configuration — ESP32 (original WROOM-32)
#
CONFIG_IDF_TARGET="esp32"

#
# Flash Configuration
#
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

#
# Partition Table — 1MB app + 1MB NVS (no PSRAM on WROOM-32)
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# ESP32-Specific Configuration
#
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DATA_CACHE_32KB=y
CONFIG_ESP32_DATA_CACHE_LINE_32B=y

#
# Memory Configuration — No PSRAM on WROOM-32
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_SPIRAM=n

#
# FreeRTOS Configuration
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=y

#
# ESP-NOW Configuration
#
CONFIG_ESPNOW_ENABLED=y
CONFIG_ESPNOW_SHA256_ENABLE=0
CONFIG_ESPNOW_TASK_MAX=32

#
# WiFi Configuration
#
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

#
# UART Configuration — USB CDC-ACM (UART1)
#
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_UART_NUM_1_ENABLED=y

#
# NVS Configuration
#
CONFIG_NVS_ENCRYPTED_PARTITION_TYPE=0x45
CONFIG_NVS_MAX_PARTITION_COUNT=8

#
# LVGL Configuration — Font support for common library
#
CONFIG_LV_FONT_FMT_TXT_LARGE=y

#
# Log Configuration
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
